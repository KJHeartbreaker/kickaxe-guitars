{
  "name": "web",
  "private": true,
  "scripts": {
    "prebuild": "sanity typegen generate",
    "build": "next build",
    "predev": "pnpm sanity:typegen",
    "dev": "next dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sanity:typegen": "cd ../studio && sanity schema extract --enforce-required-fields --path ../sanity.schema.json --force && cd ../web && sanity typegen generate",
    "start": "next start",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@sanity/client": "^7.28.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/uuid": "^3.0.3",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/speed-insights": "^2.1.0",
    "autoprefixer": "^10.6.2",
    "date-fns": "^4.4.0",
    "next": "^16.4.5",
    "next-sanity": "^13.4.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.22.0",
    "sanity-image": "^1.3.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "typescript": "^5.9.3"
  }
}
